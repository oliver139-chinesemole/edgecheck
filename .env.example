# EdgeCheck environment variables
# Copy this file to .env and fill in the keys you have.
# The app runs fully on seed data with NO keys configured.

# ─── Alpaca Paper Trading (optional) ─────────────────────────────────────
# Get a free paper-trading account at https://alpaca.markets
# Enables Tab C to route paper orders and fetch live price data.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── Financial Modeling Prep (optional) ───────────────────────────────────
# Get a free key at https://financialmodelingprep.com
# Enables live 13F and insider trade data refresh.
FMP_API_KEY=

# ─── App settings (optional — these have sensible defaults) ───────────────
# DB_PATH=backend/edgecheck.db
# INITIAL_CAPITAL=100000.0
# LOG_LEVEL=INFO
